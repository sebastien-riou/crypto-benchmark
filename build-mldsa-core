#!/bin/bash

set -ex

TOOLCHAIN=${1:-on/cortex-m33}
PRESET=${3:-minSizeRel}
LIB=${4:-OPEN_SOURCE}
# STUB has no goal of its own: it is built for the goal of the library it is the baseline of
GOAL=${2:-$(python3 goals.py default $LIB mldsa)}

python3 link_ext.py --preset=$PRESET
./buildit $TOOLCHAIN mldsa 44 $LIB $PRESET GOAL=$GOAL ${@:5}
./buildit $TOOLCHAIN mldsa 65 $LIB $PRESET GOAL=$GOAL ${@:5}
./buildit $TOOLCHAIN mldsa 87 $LIB $PRESET GOAL=$GOAL ${@:5}

