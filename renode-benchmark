#!/bin/bash

set -ex

ALGO=${1:-mldsa}
PSET=${2:-44}
CRYPTOLIB=${3:-OPEN_SOURCE}
GOAL=${4:-small}

./build-all-targets $ALGO $PSET $CRYPTOLIB $GOAL minSizeRel -DRAW_COM=1
set +e #allow failure as not all libs compile for all targets
./test-renode $ALGO $PSET
./show-all-uart-results --details=0 --write=1
