#!/bin/bash

set -ex

TOOLCHAIN=${1:-on/cortex-m33}
GOAL=${2:-small}
PRESET=${3:-minSizeRel}

./clean
python3 link_ext.py --preset=$PRESET --goal=$GOAL
./buildit $TOOLCHAIN mldsa 44 STUB $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 65 STUB $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 87 STUB $GOAL $PRESET ${@:4}

# allow some builds to fail
set +e 
./buildit $TOOLCHAIN mldsa 44 OPEN_SOURCE $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 65 OPEN_SOURCE $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 87 OPEN_SOURCE $GOAL $PRESET ${@:4}

./buildit $TOOLCHAIN mldsa 44 PQSHIELD $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 65 PQSHIELD $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 87 PQSHIELD $GOAL $PRESET ${@:4}

./buildit $TOOLCHAIN mldsa 44 STM32PQC $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 65 STM32PQC $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 87 STM32PQC $GOAL $PRESET ${@:4}

./buildit $TOOLCHAIN mldsa 44 WOLFSSL $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 65 WOLFSSL $GOAL $PRESET ${@:4}
./buildit $TOOLCHAIN mldsa 87 WOLFSSL $GOAL $PRESET ${@:4}

TARGET=$(basename ${TOOLCHAIN})
OUTDIR="build/$TARGET"

size ${OUTDIR}/crypto-benchmark-*.elf > ${OUTDIR}/sizes.txt
