#!/usr/bin/env python3
import argparse
import logging
import os
import runpy
import shlex
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SIBLINGS_DIR = os.path.dirname(SCRIPT_DIR)

WARNINGS = []
RESULTS = []


def warn(message):
    logging.warning(message)
    WARNINGS.append(message)


def record(name, status):
    RESULTS.append((name, status))


def load_manifest():
    manifest_path = os.path.join(SCRIPT_DIR, "setup_manifest.py")
    return runpy.run_path(manifest_path)


def parse_bool_flag(value):
    v = value.strip().lower()
    if v in ("1", "on", "true"):
        return True
    if v in ("0", "off", "false"):
        return False
    raise argparse.ArgumentTypeError(f"expected one of 0/1, on/off, true/false, got {value!r}")


def build_url(entry, protocol, host_url_templates):
    return host_url_templates[entry["host"]][protocol].format(path=entry["path"])


def prompt(question, options, default):
    if not options:
        answer = input(f"{question} [{default}]: ").strip()
        return answer or default
    labelled = "/".join(o if o != default else o.upper() for o in options)
    while True:
        answer = input(f"{question} ({labelled}): ").strip().lower()
        if not answer:
            return default
        if answer in options:
            return answer
        print(f"Please answer one of: {', '.join(options)}")


def flat_addon_list(addons):
    return [entry for group in addons.values() for entry in group]


def validate_addon_names(names, addons):
    known = {entry["name"] for entry in flat_addon_list(addons)}
    unknown = [n for n in names if n not in known]
    if unknown:
        raise SystemExit(f"Unknown add-on(s): {', '.join(unknown)}. Use --list-addons to see valid names.")


def prompt_addon_selection(addons):
    flat = flat_addon_list(addons)
    print("Available add-ons:")
    for entry in flat:
        tag = entry.get("codename", "")
        internal = " (internal, requires gitlab.pqsh.net access)" if entry.get("internal") else ""
        print(f"  - {entry['name']}{f' [{tag}]' if tag else ''}{internal}")
    answer = input("Comma-separated add-on names to include (blank for none): ").strip()
    if not answer:
        return []
    names = [n.strip() for n in answer.split(",") if n.strip()]
    validate_addon_names(names, addons)
    return names


def interactive_allowed(args):
    return sys.stdin.isatty() and not args.yes


def resolve_options(args, addons):
    level = args.level
    selected_addons = None
    if args.addons is not None:
        selected_addons = [n.strip() for n in args.addons.split(",") if n.strip()]
        validate_addon_names(selected_addons, addons)
        level = level or "custom"

    if level is None:
        if interactive_allowed(args):
            level = prompt("Setup level", ["minimal", "full", "custom"], "minimal")
        else:
            level = "minimal"

    if level == "custom" and selected_addons is None:
        if interactive_allowed(args):
            selected_addons = prompt_addon_selection(addons)
        else:
            selected_addons = []

    protocol = args.protocol
    if protocol is None:
        if os.environ.get("CRYPTO_BENCHMARK_USE_GIT_SSH"):
            protocol = "ssh"
        elif interactive_allowed(args):
            protocol = prompt("Git protocol", ["https", "ssh"], "https")
        else:
            protocol = "https"

    version_mode = args.version_mode
    if version_mode is None:
        if interactive_allowed(args):
            version_mode = prompt("Version", ["pinned", "latest"], "pinned")
        else:
            version_mode = "pinned"

    test_renode = args.test_renode
    if test_renode is None:
        if interactive_allowed(args):
            test_renode = prompt("Test with Renode", ["on", "off"], "on") == "on"
        else:
            test_renode = True

    return level, selected_addons, protocol, version_mode, test_renode


def check_existing_state(name, dest, entry, version_mode):
    status = subprocess.run(["git", "-C", dest, "status", "--porcelain"], capture_output=True, text=True)
    if status.stdout.strip():
        warn(f"{name}: existing working copy has uncommitted/staged changes")

    if version_mode == "pinned":
        expected = entry["default_tag"]
        described = subprocess.run(["git", "-C", dest, "describe", "--tags", "--exact-match"], capture_output=True, text=True)
        current = described.stdout.strip()
        if described.returncode != 0 or current != expected:
            warn(f"{name}: expected to be on tag {expected!r} but found {current or '(none / detached HEAD)'!r}")
    else:
        branch = subprocess.run(["git", "-C", dest, "symbolic-ref", "--short", "HEAD"], capture_output=True, text=True)
        # We can't reliably know the remote's default branch name offline, so
        # for 'latest' we only check that HEAD isn't detached at some fixed tag.
        if branch.returncode != 0:
            warn(f"{name}: expected to be on a branch (version=latest) but HEAD is detached")


def clone_repo(name, entry, dest, protocol, version_mode, host_url_templates, dry_run):
    url = build_url(entry, protocol, host_url_templates)
    cmd = ["git", "clone", "--depth=1"]
    if version_mode == "pinned":
        cmd += ["--branch", entry["default_tag"], "--single-branch"]
    if entry.get("recurse_submodules"):
        cmd.append("--recurse-submodules")
    cmd += [url, dest]
    logging.info("cloning %s: %s", name, " ".join(cmd))
    if dry_run:
        return
    subprocess.run(cmd, check=True)


def run_build_steps(name, entry, dest, dry_run):
    build_steps = entry.get("build")
    if not build_steps:
        docs_hint = entry.get("docs_hint")
        if docs_hint:
            logging.info("%s: no automated build defined, see %s", name, docs_hint)
        return
    for step in build_steps:
        cmd = shlex.split(step)
        logging.info("building %s: %s", name, step)
        if dry_run:
            continue
        subprocess.run(cmd, cwd=dest, check=True)


def process_repo(name, entry, protocol, version_mode, host_url_templates, dry_run, required):
    dest = os.path.join(SIBLINGS_DIR, name)
    try:
        if os.path.isdir(dest):
            # An existing sibling is treated as already set up: re-running this
            # tool must not re-trigger a repo's build steps (e.g. lean-benchmark's
            # own build-all-targets has no error suppression and covers ~25
            # boards -- one flaky failure on a re-run silently wipes out its
            # previously-working dist/ output for everything downstream).
            logging.info("%s: already exists at %s, skipping clone and build", name, dest)
            check_existing_state(name, dest, entry, version_mode)
            record(name, "skipped-existing")
            return
        clone_repo(name, entry, dest, protocol, version_mode, host_url_templates, dry_run)
        record(name, "cloned")
        run_build_steps(name, entry, dest, dry_run)
    except subprocess.CalledProcessError as e:
        if required:
            raise
        warn(f"{name}: {e}")
        record(name, "failed")


def print_summary(manual_only, level):
    print("\n=== Setup summary ===")
    for name, status in RESULTS:
        print(f"  {name}: {status}")
    if level == "full":
        for entry in manual_only:
            print(f"  {entry['name']}: manual setup required -- {entry['note']}")

    if WARNINGS:
        print("\n=== Summary of warnings ===")
        for w in WARNINGS:
            print(f"  - {w}")


def main():
    scriptname = os.path.basename(__file__)
    parser = argparse.ArgumentParser(scriptname)
    parser.add_argument("--level", choices=["minimal", "full", "custom"], default=None)
    parser.add_argument("--addons", default=None, metavar="NAME[,NAME...]",
                         help="add-on names to include; implies --level custom")
    parser.add_argument("--protocol", choices=["https", "ssh"], default=None)
    parser.add_argument("--version", dest="version_mode", choices=["pinned", "latest"], default=None)
    parser.add_argument("--test-renode", dest="test_renode", type=parse_bool_flag, default=None,
                         metavar="{0,1,on,off,true,false}")
    parser.add_argument("legacy_test_renode", nargs="?", type=parse_bool_flag, default=None,
                         help=argparse.SUPPRESS)  # backward compat: old callers run `./initial-setup 0|1`
    parser.add_argument("--pipenv-args", default="--verbose")
    parser.add_argument("-y", "--yes", action="store_true", help="never prompt, use flags/defaults only")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--list-addons", action="store_true")
    levels = ("DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL")
    parser.add_argument("--log-level", default="INFO", choices=levels)
    args = parser.parse_args()
    if args.test_renode is None and args.legacy_test_renode is not None:
        args.test_renode = args.legacy_test_renode

    logging.basicConfig(level=args.log_level, format="%(levelname)s: %(message)s")

    manifest = load_manifest()
    core, minimal_demo, addons, manual_only = (
        manifest["CORE"], manifest["MINIMAL_DEMO"], manifest["ADDONS"], manifest["MANUAL_ONLY"]
    )
    host_url_templates = manifest["HOST_URL_TEMPLATES"]

    if args.list_addons:
        for category, entries in addons.items():
            print(f"{category}:")
            for entry in entries:
                tag = entry.get("codename", "")
                internal = " (internal, requires gitlab.pqsh.net access)" if entry.get("internal") else ""
                print(f"  - {entry['name']}{f' [{tag}]' if tag else ''}{internal}")
        return 0

    level, selected_addons, protocol, version_mode, test_renode = resolve_options(args, addons)

    for entry in core:
        process_repo(entry["name"], entry, protocol, version_mode, host_url_templates, args.dry_run, required=True)

    # "custom" means "core + only the addons the user picked" -- it must not
    # also drag in the (expensive, multi-toolchain) OPEN_SOURCE demo that
    # "minimal"/"full" are about.
    run_demo = level in ("minimal", "full")
    if run_demo:
        for entry in minimal_demo:
            process_repo(entry["name"], entry, protocol, version_mode, host_url_templates, args.dry_run, required=True)

    flat_addons = flat_addon_list(addons)
    if level == "full":
        plan = flat_addons
    elif level == "custom":
        by_name = {entry["name"]: entry for entry in flat_addons}
        plan = [by_name[n] for n in selected_addons if n in by_name]
    else:
        plan = []

    for entry in plan:
        process_repo(entry["name"], entry, protocol, version_mode, host_url_templates, args.dry_run, required=False)

    if not args.dry_run:
        pipenv_install_cmd = ["pipenv"] + shlex.split(args.pipenv_args) + ["install"]
        subprocess.run(pipenv_install_cmd, cwd=SCRIPT_DIR, check=True)
        subprocess.run(["pipenv", "sync"], cwd=SCRIPT_DIR, check=True)

        if run_demo:
            # Renode's UART capture is one-way (Renode -> log file only), so
            # firmware built with the two-way leancom default (RAW_COM=0)
            # hangs forever waiting for a handshake response Renode can never
            # send. -DRAW_COM=1 is only for that case; real-hardware use
            # keeps the leancom default.
            raw_com = "1" if test_renode else "0"
            subprocess.run(["./build-all-targets", "mldsa", "44", "OPEN_SOURCE", "small", "minSizeRel",
                             f"-DRAW_COM={raw_com}"],
                            cwd=SCRIPT_DIR, check=True)

            if test_renode:
                subprocess.run(["./test-renode"], cwd=SCRIPT_DIR, check=True)
                subprocess.run(["./show-all-uart-results", "--details=0"], cwd=SCRIPT_DIR, check=True)

    print_summary(manual_only, level)
    return 0


if __name__ == "__main__":
    sys.exit(main())
