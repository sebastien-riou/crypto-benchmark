#!/bin/bash

set -ex

RENODE=${1:-1}
LEAN_BENCHMARK=${2:-c4bf8db7}
DILITHIUM_LOWRAM=${3:-068c8d32}


cd ..

if [[ ! -z $CRYPTO_BENCHMARK_USE_GIT_SSH ]]; then
    git clone git@github.com:sebastien-riou/lean-benchmark.git
    git clone git@github.com:sebastien-riou/dilithium-lowram.git
else
    git clone https://github.com/sebastien-riou/lean-benchmark.git
    git clone https://github.com/sebastien-riou/dilithium-lowram.git
fi


cd dilithium-lowram
git checkout $DILITHIUM_LOWRAM
./build-all-targets
cd ..

cd lean-benchmark
git checkout $LEAN_BENCHMARK
./build-all-targets
cd ..

cd crypto-benchmark
pipenv install
pipenv sync
python3 link_ext.py
./build-all-targets

if [ "$RENODE" == "1" ]; then
    ./test-renode
    ./show-all-results --details=0
fi
