#!/bin/bash

set -ex

RENODE=${1:-1}
LEAN_BENCHMARK_TAG=${2:-v0.0.6}
DILITHIUM_LOWRAM=${3:-6e6e440}


cd ..

if [[ ! -z $CRYPTO_BENCHMARK_USE_GIT_SSH ]]; then
    LEAN_BENCHMARK_URL=git@github.com:sebastien-riou/lean-benchmark.git
    git clone git@github.com:sebastien-riou/dilithium-lowram.git
else
    LEAN_BENCHMARK_URL=https://github.com/sebastien-riou/lean-benchmark.git
    git clone https://github.com/sebastien-riou/dilithium-lowram.git
fi

git clone --depth=1 $LEAN_BENCHMARK_URL --branch $LEAN_BENCHMARK_TAG --single-branch --recurse-submodules

cd dilithium-lowram
git checkout $DILITHIUM_LOWRAM
./build-all-targets
cd ..

cd lean-benchmark
./build-all-targets debug
./build-all-targets minSizeRel
cd ..

cd crypto-benchmark
pipenv install
pipenv sync
python3 link_ext.py
./build-all-targets mldsa 44 OPEN_SOURCE small minSizeRel -DRAW_COM=$RENODE

if [ "$RENODE" == "1" ]; then
    ./test-renode
    ./show-all-uart-results --details=0
fi
